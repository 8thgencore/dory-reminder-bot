# For docker-compose.dev.yaml. Copy to .env.dev and set TELEGRAM_TOKEN.

# Core
ENV=dev
TELEGRAM_TOKEN=your_bot_token_here
PROXY_URL=

# Database
DB_PATH=data/reminders.db

# Mini App (keep disabled locally; needs a public HTTPS URL)
WEBAPP_ENABLED=false
WEBAPP_ADDR=:8080
WEBAPP_PUBLIC_URL=
WEBAPP_INITDATA_TTL=24h
