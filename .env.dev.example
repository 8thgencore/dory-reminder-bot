# Development environment for docker-compose.dev.yaml.
# Copy to .env.dev and set TELEGRAM_TOKEN before starting the stack.
ENV=dev
TELEGRAM_TOKEN=your_bot_token_here
PROXY_URL=
DB_PATH=data/reminders.db

# Keep Mini App disabled for local-only development. Telegram requires a
# public HTTPS URL before WEBAPP_ENABLED can be turned on.
WEBAPP_ENABLED=false
WEBAPP_ADDR=:8080
WEBAPP_PUBLIC_URL=
WEBAPP_INITDATA_TTL=24h
