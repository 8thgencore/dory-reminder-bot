{
	# Browsers send no SNI when connecting to a bare IP, so Caddy must be
	# told which certificate to serve — otherwise the TLS handshake fails
	# with an "internal error" alert as soon as the client's ALPN offer
	# includes h2 (all modern browsers do this by default).
	# See https://github.com/caddyserver/caddy/issues/6364
	default_sni {$CADDY_SITE_ADDR}
}

{$CADDY_SITE_ADDR} {
	# Port 80 is unavailable on this host, so certificate issuance/renewal
	# uses only the TLS-ALPN-01 challenge, which runs over the same 443
	# the site is already served on.
	tls {
		issuer acme {
			disable_http_challenge
			# Let's Encrypt only allows IP address identifiers under the
			# "shortlived" profile (~6-day certs); harmless for domains too,
			# and Caddy renews well before expiry either way.
			profile shortlived
		}
	}
	reverse_proxy bot:8080
}
