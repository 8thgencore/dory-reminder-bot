ENV=dev

TELEGRAM_TOKEN=12345678:secret
BOT_NAME=reminder_bot

# Optional outbound proxy for the Telegram Bot API (http, https or socks5).
PROXY_URL=socks5://proxy.example.internal:1080

DB_PATH=data/reminders.db

# Telegram Mini App. Telegram opens Mini Apps only over a public HTTPS URL,
# so WEBAPP_PUBLIC_URL must point at the reverse proxy in front of WEBAPP_ADDR.
WEBAPP_ENABLED=false
WEBAPP_ADDR=:8080
WEBAPP_PUBLIC_URL=https://dory.example.com
# Short name of the direct-link Mini App from @BotFather. Needed only to open the app
# from group chats; leave empty to support private chats only.
WEBAPP_SHORT_NAME=
WEBAPP_INITDATA_TTL=24h
