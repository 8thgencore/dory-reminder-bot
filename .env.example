# Core
ENV=dev
# From @BotFather. Never commit a real token.
TELEGRAM_TOKEN=your_bot_token_here
PROXY_URL=

# Database
DB_PATH=data/reminders.db

# Mini App (requires a public HTTPS URL when enabled)
WEBAPP_ENABLED=false
WEBAPP_ADDR=:8080
WEBAPP_PUBLIC_URL=
WEBAPP_INITDATA_TTL=24h

# Caddy reverse proxy (must match WEBAPP_PUBLIC_URL's host, no scheme/port)
CADDY_SITE_ADDR=
